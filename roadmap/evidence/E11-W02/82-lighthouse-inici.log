----- measure.sh -----
#!/bin/bash
# measure.sh <label>: production build of apps/clubs, served with the mock api on 4183, 3 Lighthouse runs on /inici.
S=/tmp/claude-0/-home-user-agilityhub-core-web/3d42cdcf-70a5-5d85-8acf-67e45e00fea0/scratchpad
label=$1
cd /home/user/agilityhub-core-web/apps/clubs && pnpm exec vite build --outDir $S/dist-$label --emptyOutDir > $S/lh/build-$label.log 2>&1 || { echo build failed; exit 1; }
[ -f $S/server-4185.pid ] && kill $(cat $S/server-4185.pid) 2>/dev/null; rm -f $S/server-4185.pid
sleep 1
nohup node $S/lh/mockapi/server.mjs $S/dist-$label 4185 > $S/lh/mockapi-$label.log 2>&1 &
sleep 2
grep -q "serving $S/dist-$label" $S/lh/mockapi-$label.log || { echo "server did not start"; cat $S/lh/mockapi-$label.log; exit 1; }
cd $S/lh
for i in 1 2 3; do
  CHROME_PATH=/opt/pw-browsers/chromium ./node_modules/.bin/lighthouse http://127.0.0.1:4185/inici --chrome-flags="--headless=new --no-sandbox --disable-gpu" --form-factor=mobile --only-categories=performance,accessibility,best-practices --output=json --output=html --output-path=./$label-$i --quiet
done
python3 - "$label" <<'PY'
import json,sys
label=sys.argv[1]
for i in (1,2,3):
    r=json.load(open(f'{label}-{i}.report.json'))
    a=r['audits']
    cats={k:round(v['score']*100) for k,v in r['categories'].items()}
    print(f"{label} run {i}: {cats} TTI {a['interactive']['numericValue']:.0f} ms · FCP {a['first-contentful-paint']['numericValue']:.0f} ms · LCP {a['largest-contentful-paint']['numericValue']:.0f} ms · TBT {a['total-blocking-time']['numericValue']:.0f} ms · {r['fetchTime']}")
PY

----- mockapi/server.ts (bundled with esbuild: NODE_PATH=packages/api-client/node_modules esbuild server.ts --bundle --platform=node --format=esm --alias:@agilityhub/api-client/mocks=./src/mocks/handlers.ts) -----
// A production build served with the mock world over HTTP: the static files of `dist`, and every
// api, token and auth route answered by the same MSW handlers the app's mock mode uses.
import { createServer } from "node:http";
import { readFile, stat, writeFile } from "node:fs/promises";
import path from "node:path";
import { gzipSync } from "node:zlib";

import { handlers } from "@agilityhub/api-client/mocks";
import { getResponse } from "msw";

const [dist = "", port = "4183"] = process.argv.slice(2);
const types: Record<string, string> = {
  ".css": "text/css",
  ".html": "text/html; charset=utf-8",
  ".js": "text/javascript",
  ".json": "application/json",
  ".png": "image/png",
  ".svg": "image/svg+xml",
  ".webmanifest": "application/manifest+json",
  ".woff2": "font/woff2",
};
const API = /^\/(api|oauth2|auth|connect)\//u;
/** LOGO_URLS=1: the branding's logos as the contract sends them, URLs, not the fixture's base64. */
const logoUrls = process.env.LOGO_URLS === "1";
const logos = new Map<string, Buffer>();
const PNG = "data:image/png;base64,";

createServer(async (incoming, outgoing) => {
  const url = new URL(incoming.url ?? "/", `http://127.0.0.1:${port}`);
  const logo = logos.get(url.pathname);
  if (logo !== undefined) {
    outgoing.writeHead(200, { "cache-control": "public, max-age=3600", "content-type": "image/png" });
    outgoing.end(logo);
    return;
  }
  if (API.test(url.pathname)) {
    const chunks: Buffer[] = [];
    for await (const chunk of incoming) chunks.push(chunk as Buffer);
    const body = chunks.length === 0 ? undefined : Buffer.concat(chunks);
    const headers = new Headers();
    for (const [key, value] of Object.entries(incoming.headers)) {
      if (typeof value === "string") headers.set(key, value);
    }
    const method = incoming.method ?? "GET";
    const request = new Request(url, {
      body: method === "GET" || method === "HEAD" ? undefined : body,
      headers,
      method,
    });
    const response =
      (await getResponse(handlers, request)) ??
      new Response(JSON.stringify({ code: "NOT_FOUND", message: "Not found" }), {
        headers: { "content-type": "application/json" },
        status: 404,
      });
    let answer = Buffer.from(await response.arrayBuffer());
    if (logoUrls && url.pathname === "/api/v1/branding" && response.ok) {
      const branding = JSON.parse(answer.toString("utf8")) as { theme: Record<string, unknown> };
      for (const key of ["logoUrl", "logoDarkUrl", "markUrl"]) {
        const value = branding.theme[key];
        if (typeof value !== "string" || !value.startsWith(PNG)) continue;
        const file = "/brand/" + key + ".png";
        logos.set(file, Buffer.from(value.slice(PNG.length), "base64"));
        branding.theme[key] = file;
      }
      answer = Buffer.from(JSON.stringify(branding));
    }
    const out: Record<string, string> = {};
    response.headers.forEach((value, key) => {
      if (key !== "content-length") out[key] = value;
    });
    outgoing.writeHead(response.status, out);
    outgoing.end(answer);
    return;
  }
  let file = path.join(dist, decodeURIComponent(url.pathname));
  try {
    if (!(await stat(file)).isFile()) throw new Error("dir");
  } catch {
    file = path.join(dist, "index.html");
  }
  const content = await readFile(file);
  const type = types[path.extname(file)] ?? "application/octet-stream";
  const cache = file.includes("/assets/") ? "public, max-age=31536000, immutable" : "no-cache";
  const accepts = String(incoming.headers["accept-encoding"] ?? "");
  if (/text|javascript|json|svg|manifest/u.test(type) && accepts.includes("gzip")) {
    outgoing.writeHead(200, { "cache-control": cache, "content-encoding": "gzip", "content-type": type });
    outgoing.end(gzipSync(content, { level: 9 }));
  } else {
    outgoing.writeHead(200, { "cache-control": cache, "content-type": type });
    outgoing.end(content);
  }
}).listen(Number(port), "127.0.0.1", () => {
  void writeFile(`${dist}/../server-${port}.pid`, String(process.pid));
  console.log(`serving ${dist} with the mock api on ${port}${logoUrls ? " (logos as URLs)" : ""}`);
});

