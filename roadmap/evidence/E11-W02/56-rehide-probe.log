----- rehide-probe.mjs -----
// For each screen, after a full load: does the shell's loading state come back once the screen's
// content has been shown (a nested suspension hiding a shown screen)? Also via the tab bar.
import { readFileSync } from "node:fs";
import { chromium } from "/home/user/agilityhub-core-web/apps/clubs/node_modules/@playwright/test/index.mjs";

const branding = JSON.parse(readFileSync("/home/user/agilityhub-core-web/packages/api-client/src/mocks/fixtures/branding-canic.json", "utf8"));
const base = "http://127.0.0.1:4173";
const plans = [
  { scenario: "member", email: "laura@example.test", paths: ["/inici", "/reservar", "/entrenaments", "/avui", "/perfil", "/info", "/notificacions", "/historic", "/gossos", "/dades", "/rebuts", "/inactivitat", "/baixa", "/reserves/booking-duna-mon3", "/reserves/booking-duna-mon3?checkout=cs_e8_w02"] },
  { scenario: "instructor", email: "laura@example.test", paths: ["/instructor/avui", "/instructor/dia", "/instructor/alumnes", "/recorreguts/muntat/ring-central"] },
];
const browser = await chromium.launch({ executablePath: "/opt/pw-browsers/chromium" });
for (const plan of plans) {
  for (const path of plan.paths) {
    const context = await browser.newContext({ viewport: { height: 812, width: 375 } });
    const page = await context.newPage();
    await page.addInitScript(({ cachedBranding, scenario }) => {
      localStorage.setItem("agilityhub.locale", "ca");
      localStorage.setItem("agilityhub.mockScenario", scenario);
      localStorage.setItem(`agilityhub.branding:${location.host}`, JSON.stringify(cachedBranding));
      const events = [];
      window.__events = events;
      let shown = false;
      let loading = false;
      const tick = () => {
        const main = document.querySelector(".clubs-shell__content");
        const isLoading = document.querySelector('.clubs-shell__content [role="status"][aria-label="Carregant"]') !== null;
        const hasContent = main !== null && [...main.children].some((el) => el.getAttribute("role") !== "status" && el.checkVisibility());
        if (hasContent && !isLoading) shown = true;
        if (isLoading !== loading) {
          events.push(`${Math.round(performance.now())} loading=${isLoading}${shown && isLoading ? " AFTER CONTENT" : ""} ${location.pathname}`);
          loading = isLoading;
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }, { cachedBranding: branding, scenario: plan.scenario });
    await page.goto(`${base}/entrar`);
    await page.getByLabel("Correu electrònic").fill(plan.email);
    await page.getByLabel("Contrasenya").fill("secret-password");
    await page.getByRole("button", { exact: true, name: "ENTRA" }).click();
    await page.waitForURL(/\/(inici|instructor\/dia|instructor\/avui|perfil-acces)/u, { timeout: 30000 }).catch(() => undefined);
    await page.goto(`${base}${path}`);
    await page.waitForLoadState("networkidle").catch(() => undefined);
    await page.waitForTimeout(2500);
    const events = await page.evaluate(() => window.__events);
    const bad = events.filter((e) => e.includes("AFTER CONTENT"));
    console.log(`${plan.scenario} ${path}: ${bad.length === 0 ? "ok" : "REHIDDEN"}  [${events.join(" | ")}]`);
    await context.close();
  }
}
await browser.close();
