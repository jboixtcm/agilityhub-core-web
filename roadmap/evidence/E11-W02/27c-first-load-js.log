----- initial-js.py -----
import gzip, re, sys, os
dist = sys.argv[1]
html = open(os.path.join(dist, "index.html"), encoding="utf-8").read()
files = re.findall(r'(?:src|href)="/(assets/[^"]+\.js)"', html)
total = 0
for f in files:
    data = open(os.path.join(dist, f), "rb").read()
    size = len(gzip.compress(data, 9))
    total += size
    print(f"  {f}  {size / 1000:.2f} kB gz")
print(f"  total first-load JavaScript (index.html's script and modulepreloads): {total / 1000:.2f} kB gz")
