-  if (!byLabel || !looksLikeLegacyPerimeterOrder(byLabel)) {
-    return [...markers];
-  }
-
-  const targetByLabel: Record<CanonicalLabel, DBRingMarker> = {
-    A: byLabel.B,
-    B: byLabel.F,
-    C: byLabel.D,
-    D: byLabel.A,
-    E: byLabel.E,
-    F: byLabel.C,
-  };
-
