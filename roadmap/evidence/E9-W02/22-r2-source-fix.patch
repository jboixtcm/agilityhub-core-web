-  });
-}
-
-function activeCanonicalMarkersByLabel(
-  markers: readonly DBRingMarker[],
-): Record<CanonicalLabel, DBRingMarker> | null {
-  const out = new Map<CanonicalLabel, DBRingMarker>();
