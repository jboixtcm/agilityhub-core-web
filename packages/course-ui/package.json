{
  "name": "@agilityhub/course-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./assets/*": "./assets/*"
  },
  "dependencies": {
    "@agilityhub/course-core": "workspace:*",
    "@agilityhub/shared-types": "workspace:*",
    "react": "catalog:",
    "three": "catalog:"
  },
  "devDependencies": {
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "catalog:",
    "jsdom": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src tests --max-warnings 0 --config ../../eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
