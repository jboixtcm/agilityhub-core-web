          "sort": { "type": "array", "items": { "type": "string" } },
          "shared": { "type": "boolean" }
        }
      },
      "SavedViewRequest": {
        "type": "object",
        "required": ["listKey", "name", "columns", "filters", "sort", "shared"],
        "properties": {
          "listKey": { "type": "string" },
          "name": { "type": "string", "maxLength": 40 },
          "columns": { "type": "array", "items": { "type": "string" } },
          "filters": { "type": "array", "items": { "$ref": "#/components/schemas/ListFilter" } },
          "sort": { "type": "array", "items": { "type": "string" } },
          "shared": { "type": "boolean" }
        }
      },
