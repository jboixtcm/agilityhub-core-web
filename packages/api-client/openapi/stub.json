              }
            }
          },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/members/export": {
      "get": {
        "operationId": "exportMembers",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/ExportFormat" },
          { "$ref": "#/components/parameters/Sort" },
          { "$ref": "#/components/parameters/Search" },
          { "$ref": "#/components/parameters/Filter" },
          { "$ref": "#/components/parameters/Columns" }
        ],
        "responses": {
          "200": {
            "description": "Member export",
            "content": {
              "application/octet-stream": { "schema": { "type": "string", "format": "binary" } }
            }
          },
          "202": {
            "description": "Asynchronous export",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ExportJobResponse" } }
            }
          },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/dogs": {
      "get": {
        "operationId": "listDogs",
        "security": [{ "bearerAuth": [] }],
        "x-filterable": [
          "name(contains)",
          "breed(contains)",
          "levelId",
          "memberId",
          "ownerName(contains)",
          "status",
          "freeTrainingAllowed",
          "hasLicense",
          "licenseOrganisation",
          "hasPendingDocuments",
          "sex",
          "birthDate",
          "chip",
          "registeredAt",
          "levelAssignedAt"
        ],
        "x-sortable": [
          "name",
          "breed",
          "levelOrder",
          "ownerLastName",
          "registeredAt",
          "levelAssignedAt"
        ],
        "x-columns": [
          { "key": "name", "label": "Gos", "defaultVisible": true },
          { "key": "breed", "label": "Raça", "defaultVisible": true },
          {
            "key": "level",
            "label": "Nivell",
            "defaultVisible": true,
            "setting": "levels.enabled"
          },
          { "key": "owner", "label": "Abonat", "defaultVisible": true },
          {
            "key": "freeTraining",
            "label": "Entrenament lliure",
            "defaultVisible": true,
            "module": "FREE_TRAINING"
          },
          { "key": "licenses", "label": "Llicències", "defaultVisible": true },
          { "key": "displayStatus", "label": "Estat", "defaultVisible": true },
          { "key": "sex", "label": "Sexe" },
          { "key": "age", "label": "Edat" },
          { "key": "chip", "label": "Xip" },
          { "key": "pendingDocuments", "label": "Documents pendents" },
          { "key": "levelAssignedAt", "label": "Al nivell des de" },
          { "key": "pack", "label": "Pack", "module": "PACKS" },
          { "key": "registeredAt", "label": "Data d'alta" }
        ],
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/Size" },
          { "$ref": "#/components/parameters/Sort" },
          { "$ref": "#/components/parameters/Search" },
          { "$ref": "#/components/parameters/Filter" },
          { "$ref": "#/components/parameters/Fields" }
        ],
        "responses": {
          "200": {
            "description": "Universal dog list",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/DogListResponse" } }
            }
          },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/dogs/filter-values": {
      "get": {
        "operationId": "listDogFilterValues",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/FilterField" },
          { "$ref": "#/components/parameters/Search" },
          { "$ref": "#/components/parameters/Filter" }
        ],
        "responses": {
          "200": {
            "description": "Dog facet values",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FilterValuesResponse" }
              }
            }
          },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/dogs/export": {
      "get": {
        "operationId": "exportDogs",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/ExportFormat" },
          { "$ref": "#/components/parameters/Sort" },
          { "$ref": "#/components/parameters/Search" },
          { "$ref": "#/components/parameters/Filter" },
          { "$ref": "#/components/parameters/Columns" }
        ],
        "responses": {
          "200": {
            "description": "Dog export",
            "content": {
              "application/octet-stream": { "schema": { "type": "string", "format": "binary" } }
            }
          },
          "202": {
            "description": "Asynchronous export",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ExportJobResponse" } }
            }
          },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/saved-views": {
      "get": {
        "operationId": "listSavedViews",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "listKey", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Saved views for a list",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/SavedView" } }
              }
            }
          },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      },
      "post": {
        "operationId": "createSavedView",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/SavedViewRequest" } }
          }
        },
        "responses": {
          "201": {
            "description": "Saved view created",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SavedView" } }
            }
          },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/saved-views/{id}": {
      "put": {
        "operationId": "updateSavedView",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ResourceId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/SavedViewRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Saved view updated",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SavedView" } }
            }
          },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      },
      "delete": {
        "operationId": "deleteSavedView",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ResourceId" }],
        "responses": {
          "204": { "description": "Saved view deleted" },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/auth/magic-link": {
      "servers": [
        {
          "url": "https://id.agilitydoghub.com"
        }
      ],
      "post": {
        "operationId": "requestMagicLink",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MagicLinkRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Neutral accepted response"
          },
          "default": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    },
    "/auth/handoff": {
      "servers": [
        {
          "url": "https://id.agilitydoghub.com"
        }
      ],
      "post": {
        "operationId": "createHandoff",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HandoffRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "One-time handoff code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HandoffResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    },
    "/oauth2/revoke": {
      "servers": [
        {
          "url": "https://id.agilitydoghub.com"
        }
      ],
      "post": {
        "operationId": "revokeToken",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RevokeTokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token revoked"
          },
          "default": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Service health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    },
    "/oauth2/token": {
      "servers": [
        {
          "url": "https://id.agilitydoghub.com"
        }
      ],
      "post": {
        "operationId": "issueToken",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/TokenGrantRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OAuth2 token response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "schema": { "type": "integer", "minimum": 0, "default": 0 }
      },
      "Size": {
        "name": "size",
        "in": "query",
        "schema": { "type": "integer", "enum": [20, 50, 200, 1000], "default": 50 }
      },
      "Sort": {
        "name": "sort",
        "in": "query",
        "style": "form",
        "explode": true,
        "schema": { "type": "array", "items": { "type": "string" } }
      },
      "Search": { "name": "q", "in": "query", "schema": { "type": "string" } },
      "Filter": {
        "name": "filter",
        "in": "query",
        "style": "form",
        "explode": true,
        "schema": { "type": "array", "items": { "type": "string" } }
      },
      "Fields": { "name": "fields", "in": "query", "schema": { "type": "string" } },
      "Columns": {
        "name": "columns",
        "in": "query",
        "required": true,
        "schema": { "type": "string" }
      },
      "FilterField": {
        "name": "field",
        "in": "query",
        "required": true,
        "schema": { "type": "string" }
      },
      "ExportFormat": {
        "name": "format",
        "in": "query",
        "required": true,
        "schema": { "type": "string", "enum": ["xlsx", "pdf"] }
      },
      "ResourceId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "ApiError": {
        "description": "Standard API error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "ApiErrorResponse": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {},
          "traceId": {
            "type": "string"
          }
        }
      },
      "Money": {
        "type": "object",
        "required": ["amountMinor", "currency"],
        "properties": {
          "amountMinor": { "type": "integer" },
          "currency": { "type": "string" }
        }
      },
      "ListFilter": {
        "type": "object",
        "required": ["field", "op", "value"],
        "properties": {
          "field": { "type": "string" },
          "op": {
            "type": "string",
            "enum": [
              "eq",
              "ne",
              "in",
              "nin",
              "lt",
              "lte",
              "gt",
              "gte",
              "contains",
              "startsWith",
              "exists",
              "between"
            ]
          },
          "value": { "type": "string" },
          "label": { "type": "string" },
          "valueLabel": { "type": "string" }
        }
      },
      "FilterValue": {
        "type": "object",
        "required": ["value", "label", "count"],
        "properties": {
          "value": { "type": "string" },
          "label": { "type": "string" },
          "count": { "type": "integer" }
        }
      },
      "FilterValuesResponse": {
        "type": "object",
        "required": ["field", "values"],
        "properties": {
          "field": { "type": "string" },
          "values": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FilterValue" }
          }
        }
      },
      "DisplayStatus": {
        "type": "object",
        "required": ["kind", "label"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["PENDING", "ACTIVE", "INACTIVE_PERIOD", "LEAVE_SCHEDULED", "LEFT"]
          },
          "label": { "type": "string" },
          "date": { "type": "string", "format": "date" }
        }
      },
      "MemberListItem": {
        "type": "object",
        "required": [
          "id",
          "memberNumber",
          "firstName",
          "lastName",
          "fullName",
          "dogs",
          "plan",
          "status",
          "displayStatus",
          "contact",
          "joinedAt",
          "bookingBlocked",
          "imageRightsGranted",
          "roles",
          "city",
          "postalCode",
          "pendingDocuments",
          "freeTrainingAllowed",
          "birthDate",
          "gender",
          "idDocument"
        ],
        "properties": {
          "id": { "type": "string" },
          "memberNumber": { "type": "integer" },
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "fullName": { "type": "string" },
          "dogs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "levelCode"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "levelCode": { "type": "string" }
              }
            }
          },
          "plan": {
            "type": "object",
            "required": ["id", "name", "summary"],
            "properties": {
