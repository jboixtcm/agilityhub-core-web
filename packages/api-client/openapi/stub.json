          "lastName",
          "fullName(contains)",
          "status",
          "displayStatus",
          "planId",
          "priceId",
          "paymentMethodType",
          "nextInvoiceDate",
          "joinedAt",
          "leaveDate",
          "bookingBlocked",
          "familyGroupId",
          "imageRightsGranted",
          "roles",
          "city",
          "postalCode",
          "dogLevelId",
          "dogName(contains)",
          "hasPendingDocuments",
          "freeTrainingAllowed",
          "gender",
          "birthDate"
        ],
        "x-sortable": [
          "lastName",
          "firstName",
          "memberNumber",
          "joinedAt",
          "leaveDate",
          "nextInvoiceDate",
          "city"
        ],
        "x-columns": [
          { "key": "fullName", "label": "Abonat", "defaultVisible": true },
          { "key": "dogs", "label": "Gossos (nivell)", "defaultVisible": true },
          { "key": "plan", "label": "Modalitat", "defaultVisible": true },
          { "key": "displayStatus", "label": "Estat", "defaultVisible": true },
          { "key": "memberNumber", "label": "Número" },
          { "key": "contact", "label": "Contacte" },
          { "key": "paymentMethod", "label": "Pagament", "module": "BILLING" },
          { "key": "nextInvoiceDate", "label": "Proper rebut", "module": "BILLING" },
          { "key": "familyGroup", "label": "Grup familiar", "module": "FAMILY_GROUP" },
          { "key": "joinedAt", "label": "Alta des de" },
          { "key": "leaveDate", "label": "Data de baixa" },
          { "key": "bookingBlocked", "label": "Reserves bloquejades" },
          { "key": "imageRights", "label": "Drets d'imatge" },
          { "key": "roles", "label": "Rols" },
          { "key": "city", "label": "Població" },
          { "key": "postalCode", "label": "CP" },
          { "key": "pendingDocuments", "label": "Documents pendents" },
          { "key": "freeTraining", "label": "Entrenament lliure", "module": "FREE_TRAINING" },
          { "key": "birthDate", "label": "Data de naixement" },
          { "key": "gender", "label": "Gènere" },
          { "key": "idDocument", "label": "DNI" }
        ],
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/Size" },
          { "$ref": "#/components/parameters/Sort" },
          { "$ref": "#/components/parameters/Search" },
          { "$ref": "#/components/parameters/Filter" },
          { "$ref": "#/components/parameters/Fields" }
        ],
        "responses": {
          "200": {
            "description": "Universal member list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MemberListResponse" }
              }
            }
          },
          "default": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/members/filter-values": {
      "get": {
        "operationId": "listMemberFilterValues",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
