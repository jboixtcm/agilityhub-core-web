          "activeProfile": {
            "type": "string",
            "enum": ["MEMBER", "INSTRUCTOR", "ADMIN"]
          },
          "remember": { "type": "boolean" }
        }
      },
      "ProfileTokenResponse": {
        "type": "object",
        "required": ["access_token"],
        "properties": {
          "access_token": { "type": "string" }
        }
      },
      "UpdateMeRequest": {
        "type": "object",
        "properties": {
          "locale": { "type": "string" },
          "name": { "type": "string" }
        }
      },
      "AccountSession": {
        "type": "object",
        "required": ["id", "deviceLabel", "lastUsedAt", "current"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "deviceLabel": { "type": "string" },
          "lastUsedAt": { "type": "string", "format": "date-time" },
