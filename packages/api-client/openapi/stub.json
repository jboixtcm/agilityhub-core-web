              "email": { "type": "string", "format": "email" },
              "locale": { "type": "string" },
              "gender": {
                "type": "string",
                "enum": ["FEMALE", "MALE", "NON_BINARY", "UNSPECIFIED"]
              },
              "hasPassword": { "type": "boolean" },
              "emailVerifiedAt": { "type": "string", "format": "date-time" }
