        }
      },
      "SessionListResponse": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AccountSession" }
          }
        }
      },
      "HandoffRequest": {
        "type": "object",
        "required": ["targetClientId"],
        "properties": {
          "targetClientId": { "type": "string" }
        }
      },
      "HandoffResponse": {
        "type": "object",
        "required": ["code", "url"],
        "properties": {
          "code": { "type": "string" },
          "url": { "type": "string", "format": "uri" }
        }
      },
      "RevokeTokenRequest": {
        "type": "object",
        "required": ["token"],
        "properties": {
          "token": { "type": "string" }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": ["status", "version", "builtAt"],
        "properties": {
          "status": { "type": "string" },
          "version": { "type": "string" },
          "builtAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
