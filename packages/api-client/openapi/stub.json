                "type": "string"
              },
              "city": {
                "type": "string",
                "nullable": true
              }
            }
          },
          "theme": {
            "$ref": "#/components/schemas/Theme"
          },
          "locales": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "defaultLocale": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "countryProfile": {
            "$ref": "#/components/schemas/CountryProfile"
          },
