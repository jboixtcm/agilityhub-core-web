                "type": "string",
                "enum": ["MEMBER", "INSTRUCTOR", "ADMIN"]
              },
              "profiles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["MEMBER", "INSTRUCTOR", "ADMIN"]
                }
              },
              "defaultProfile": {
                "type": "string",
                "enum": ["MEMBER", "INSTRUCTOR", "ADMIN"]
              },
              "rememberProfile": { "type": "boolean" }
            }
          },
          "impersonation": {
            "type": "object",
            "required": ["actorName"],
            "properties": {
              "actorName": { "type": "string" }
            }
          },
          "modules": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "PasswordGrantRequest": {
        "type": "object",
        "required": ["grant_type", "username", "password"],
        "properties": {
          "grant_type": {
            "type": "string",
            "const": "password"
          },
          "username": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
