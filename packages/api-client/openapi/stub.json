            "type": "string",
            "const": "urn:agilityhub:grant:magic-link"
          },
          "token": { "type": "string" },
          "client_id": { "type": "string" }
        }
      },
      "HandoffGrantRequest": {
        "type": "object",
        "required": ["grant_type", "code", "client_id"],
        "properties": {
          "grant_type": {
            "type": "string",
            "const": "urn:agilityhub:grant:handoff"
          },
          "code": { "type": "string" },
          "client_id": { "type": "string" }
        }
      },
      "RefreshGrantRequest": {
        "type": "object",
        "required": ["grant_type", "refresh_token"],
        "properties": {
          "grant_type": {
            "type": "string",
            "const": "refresh_token"
          },
          "refresh_token": { "type": "string" }
        }
      },
      "TokenGrantRequest": {
        "oneOf": [
          { "$ref": "#/components/schemas/PasswordGrantRequest" },
          { "$ref": "#/components/schemas/MagicLinkGrantRequest" },
          { "$ref": "#/components/schemas/HandoffGrantRequest" },
          { "$ref": "#/components/schemas/RefreshGrantRequest" }
        ]
      },
      "TokenResponse": {
        "type": "object",
        "required": ["access_token", "refresh_token", "token_type", "expires_in"],
        "properties": {
          "access_token": { "type": "string" },
          "refresh_token": { "type": "string" },
          "token_type": { "type": "string" },
          "expires_in": { "type": "integer" }
        }
      },
      "MagicLinkRequest": {
        "type": "object",
        "required": ["email", "purpose", "client_id"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "purpose": { "type": "string", "enum": ["LOGIN", "RESET"] },
          "client_id": { "type": "string" },
          "redirect_uri": { "type": "string", "format": "uri" }
        }
      },
      "UpdatePasswordRequest": {
        "type": "object",
        "required": ["new", "repeat"],
        "properties": {
          "current": { "type": "string", "format": "password" },
          "new": { "type": "string", "format": "password" },
          "repeat": { "type": "string", "format": "password" }
        }
      },
      "UpdateProfileRequest": {
        "type": "object",
        "required": ["activeProfile", "remember"],
