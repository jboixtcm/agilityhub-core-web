{
  "openapi": "3.1.0",
  "info": {
    "title": "AgilityHub frontend pending API contracts",
    "version": "0.0.0-pending",
    "description": "Mocks-first contracts not yet present in the authoritative core API snapshot."
  },
  "x-schema-overlays": {
    "ActivityListItem": {
      "properties": {
        "typeDisplay": {
          "type": "string",
          "description": "S07 R-07-01 / §13-1: the D7 list shows «{title} · {typeDisplay}» (the typeLabel of the reader's locale, else the enum label), as Activity.typeDisplay."
        },
        "startTime": {
          "type": ["string", "null"],
          "description": "S07 R-07-13: club-local HH:mm of the D7 «Data» column («ds 7 · 18:30–20:30»); null without hours."
        },
        "endTime": {
          "type": ["string", "null"],
          "description": "S07 R-07-13: club-local HH:mm; null without an end time."
        },
        "allRings": {
          "type": "boolean",
          "description": "S07 §2 D7 «Pistes»: true when ringIds are all the active rings («totes — bloquejades»), as Activity.allRings."
        },
        "location": {
          "$ref": "#/components/schemas/ActivityLocation",
          "description": "S07 §2 D7 «Pistes»: «— (fora del club)» when atClub is false."
        },
        "maxPlaces": {
          "type": ["integer", "null"],
          "format": "int32",
          "description": "S07 §2 D7 «Inscripcions»: «{active}/{max} · fins el {registrationTo}»; null = no maximum («obertes · socis»)."
        }
      }
    },
    "SignupUpfrontReview": {
      "properties": {
        "firstMonth": {
          "type": "object",
          "description": "S04 §3 Member.signup.upfront.firstMonth (R-04-15), frozen at submission and recalculated by dryRun: the option, portion and start of the FIRST_MONTH line, so D2 names its month and «(mitja quota)» without reimplementing the rule. Absent without a FIRST_MONTH line. Mocks-first (web E3-W07), proposed to the api.",
          "required": ["option", "portion", "startDate", "amountDue"],
          "properties": {
            "option": { "type": "string", "enum": ["TODAY", "ALTERNATIVE"] },
            "portion": { "type": "string", "enum": ["FULL", "HALF"] },
            "startDate": { "type": "string", "format": "date" },
            "amountDue": { "$ref": "#/components/schemas/Money" }
          }
        }
      }
    }
  },
  "paths": {
    "/members/{id}/notification-preferences": {
      "put": {
        "operationId": "updateMemberNotificationPreferences",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ResourceId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationPreferencesPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated notification preferences",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationPreferences"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NotificationPreferences": {
        "type": "object",
        "required": [
          "emailByCategory",
          "smsFixed",
          "reminderOptionsMinutes",
          "pushClubNews",
          "locale",
          "availableLocales",
          "modules"
        ],
        "properties": {
          "emailByCategory": {
            "type": "object",
            "required": ["OPERATIONAL", "PERSONAL", "CLUB_CHANGES", "CLUB_NEWS"],
            "properties": {
              "OPERATIONAL": {
                "type": "boolean"
              },
              "PERSONAL": {
                "type": "boolean"
              },
              "CLUB_CHANGES": {
                "type": "boolean"
              },
              "CLUB_NEWS": {
                "type": "boolean"
              }
            }
          },
          "smsFixed": {
            "type": "boolean"
          },
          "reminderMinutesBefore": {
            "type": ["integer", "null"]
          },
          "reminderOptionsMinutes": {
            "type": "array",
            "items": {
              "type": "integer",
              "enum": [60, 120, 240, 360, 720, 1440]
            }
          },
          "pushClubNews": {
            "type": "boolean"
          },
          "locale": {
            "type": "string"
          },
          "availableLocales": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "modules": {
            "type": "object",
            "required": ["sms", "push"],
            "properties": {
              "sms": {
                "type": "boolean"
              },
              "push": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "NotificationPreferencesPatch": {
        "type": "object",
        "properties": {
          "emailByCategory": {
            "type": "object",
            "properties": {
              "OPERATIONAL": {
                "type": "boolean"
              },
              "PERSONAL": {
                "type": "boolean"
              },
              "CLUB_CHANGES": {
                "type": "boolean"
              },
              "CLUB_NEWS": {
                "type": "boolean"
              }
            }
          },
          "reminderMinutesBefore": {
            "type": ["integer", "null"]
          },
          "pushClubNews": {
            "type": "boolean"
          }
        }
      },
      "DogPendingFields": {
        "type": "object",
        "properties": {
          "handlerName": {
            "type": "string",
            "maxLength": 80
          }
        }
      },
      "LicensePendingFields": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "maxLength": 10
          },
          "division": {
            "type": "string",
            "maxLength": 20
          }
        }
      },
      "LicenseWithPendingFields": {
        "allOf": [
          {
            "$ref": "#/components/schemas/License"
          },
          {
            "$ref": "#/components/schemas/LicensePendingFields"
          }
        ]
      },
      "DogPatchPendingFields": {
        "type": "object",
        "properties": {
          "handlerName": {
            "type": "string",
            "maxLength": 80
          },
          "licenses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LicenseWithPendingFields"
            }
          }
        }
      },
      "PlanBillingMode": {
        "type": "string",
        "enum": ["MONTHLY_FEE", "MAINTENANCE"]
      }
    },
    "parameters": {
      "ResourceId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "ApiError": {
        "description": "Standard API error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    }
  }
}
