  },
  "dependencies": {
    "@tanstack/react-query": "catalog:",
    "openapi-fetch": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "openapi-typescript": "catalog:",
