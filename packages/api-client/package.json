  "exports": {
    ".": "./src/index.ts",
    "./mocks/branding-canic": "./src/mocks/branding-canic.ts",
    "./mocks": "./src/mocks/handlers.ts",
    "./mocks/browser": "./src/mocks/browser.ts",
