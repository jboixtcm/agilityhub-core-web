{
  "name": "@agilityhub/course-core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Smarter .txt importer, CourseData schema, geometry helpers and warning engine. Pure TypeScript, no UI deps.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cli/importer-summary": "./src/cli/importer-summary.ts"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src tests --max-warnings 0 --config ../../eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
