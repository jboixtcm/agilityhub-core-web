    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings 0 --config ../../eslint.config.mjs",
