{
  "name": "clubs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@agilityhub/api-client": "workspace:*",
    "@agilityhub/auth": "workspace:*",
    "@agilityhub/i18n": "workspace:*",
    "@agilityhub/ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
