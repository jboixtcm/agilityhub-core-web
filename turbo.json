{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "clubs#test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/check-clubs-bundle*.mjs",
        "$TURBO_ROOT$/e2e/core/e9-core-helpers.ts"
      ],
      "outputs": []
    },
    "@agilityhub/i18n#test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../scripts/check-es-actions*.mjs",
        "../../scripts/check-es-actions.d.mts",
        "$TURBO_ROOT$/scripts/qa-literals*.mjs"
      ],
      "outputs": []
    },
    "@agilityhub/i18n#typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "../../scripts/check-es-actions.d.mts"],
      "outputs": []
    },
    "clubs#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/check-clubs-bundle*.mjs"],
      "outputs": ["dist/**"]
    },
    "e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "env": ["PLAYWRIGHT_BROWSERS_PATH", "E2E_CAPTURE_TASK"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
